{
  "name": "comptabilite-tunisienne",
  "version": "1.0.0",
  "type": "module",
  "description": "Application de comptabilité et fiscalité tunisienne (Loi 96-112, NCT 01, G50, AP, TEJ)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ui": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs --external:../prisma/client* && esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --external:../prisma/client*",
    "build:desktop": "npm run build:ui && npm run build:server && electron-builder --win --config electron-builder.json",
    "desktop": "npm run build:ui && npm run build:server && electron .",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:no-null": "tsx tests/no-null-check.ts",
    "test": "tsx tests/accounting.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
